[Desktop Entry]
Type=Application
Version=1.0
Name=DeepSeek Harness Web
GenericName=DeepSeek Harness
Comment=Open a terminal, run dsh web, and stop it with Ctrl+C
Exec=/usr/bin/konsole -e /bin/bash -lc "exec ~/.local/share/dsh-setup/run-dsh.py --no-browser"
Icon=utilities-terminal
Terminal=false
StartupNotify=false
Categories=Development;
